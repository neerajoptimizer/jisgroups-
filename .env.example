# Public URL of the site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.jisgroup.in

# Enquiry delivery — configure ONE of the options below.
# Option A: Resend (https://resend.com) transactional email
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=JIS Website <noreply@jisgroup.in>
ENQUIRY_TO_EMAIL=jagdeep@jisgroup.in

# Option B: forward every enquiry as JSON to a webhook (Zapier, Make, Google Apps Script, CRM)
ENQUIRY_WEBHOOK_URL=

# Optional: Google Search Console verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
