# Public URL of the site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.jisgroup.in

# Enquiry emails (Gmail SMTP). The site emails each enquiry to you AND sends the customer a confirmation.
# SMTP_PASS must be a Gmail *App Password* (Google Account > Security > 2-Step Verification > App passwords).
SMTP_USER=jagdeeps5572@gmail.com
SMTP_PASS=
# Optional: where enquiries are delivered (defaults to SMTP_USER); other SMTP providers
ENQUIRY_TO_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Optional: also forward every enquiry as JSON to a webhook (Google Sheets, Zapier, CRM)
ENQUIRY_WEBHOOK_URL=

# Without SMTP_* set, enquiries go via FormSubmit (formsubmit.co) to ENQUIRY_TO_EMAIL or the site Gmail,
# with an auto-reply to the customer. One-time "Activate Form" click required. Set to 1 to disable.
FORMSUBMIT_DISABLED=

# Secret used to sign the built-in arithmetic captcha on all forms (any long random string)
CAPTCHA_SECRET=

# Google reCAPTCHA v2 ("I'm not a robot" checkbox). When both are set it replaces the arithmetic captcha.
# Create at https://www.google.com/recaptcha/admin (type: v2 Checkbox, domains: jisgroup.in).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional: Google Search Console verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
